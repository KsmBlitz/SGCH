# Copia a apps/api/.env. Los valores locales salen de `pnpm exec supabase status -o env`.
# Conexión con un rol que omite RLS: en Supabase local es el usuario postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Supabase local firma con ES256: usa el JWKS. En proyectos antiguos (HS256) usa JWT_SECRET.
JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# JWT_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
